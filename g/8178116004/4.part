inter;
  }
  button:hover { background: #2a5cc4; }
</style>
</head>
<body>
<main>
  <h1><span class="dot">&#9679;</span> the link works</h1>
  <button id="btn" type="button">click count: 0</button>
</main>
<script>
  let n = 0
  document.getElementById('btn').addEventListener('click', () => {
    document.getElementById('btn').textContent = 'click count: ' + (++n)
  })
</script>
</body>
</html>
